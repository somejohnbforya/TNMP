{
  "name": "tnmp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:engine && vite build",
    "build:only": "vite build",
    "build:engine": "node scripts/build-engine.js",
    "build:eco": "node scripts/build-eco.js",
    "build:embed": "node scripts/build-embed-pieces.js && vite build --config vite.config.embed.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "lint": "oxlint src/",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.63.0",
    "vite": "^8.0.10",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lichess-org/chessground": "^10.1.1",
    "@lichess-org/stockfish-web": "^0.3.0",
    "chess.js": "^1.4.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2"
  }
}
